# ADALAT360 - Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============================================================================
# APPLICATION
# ============================================================================
NODE_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false

# ============================================================================
# POSTGRESQL DATABASE
# ============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=adalat360
POSTGRES_USER=adalat360
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_POOL_MAX=20
POSTGRES_POOL_MIN=2
POSTGRES_IDLE_TIMEOUT=30000
POSTGRES_CONN_TIMEOUT=5000
POSTGRES_SSL=false

# ============================================================================
# MONGODB DATABASE
# ============================================================================
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=adalat360
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_POOL_MAX=20
MONGO_POOL_MIN=2
MONGO_IDLE_TIMEOUT=30000
MONGO_CONN_TIMEOUT=5000
MONGO_SSL=false

# ============================================================================
# REDIS
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
# Generate with: openssl rand -base64 32
JWT_SECRET=your_very_long_secure_random_string_at_least_256_bits_here
JWT_REFRESH_SECRET=your_refresh_secret_at_least_256_bits_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ============================================================================
# ENCRYPTION / KMS
# ============================================================================
# KMS Provider: local, aws, azure, gcp, hashicorp
KMS_PROVIDER=local
KMS_REGION=us-east-1
KMS_KEY_ID=
KMS_ENDPOINT=
KMS_ACCESS_KEY_ID=
KMS_SECRET_ACCESS_KEY=

# ============================================================================
# STORAGE (S3/MinIO)
# ============================================================================
# Provider: aws, minio, azure, gcp
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=adalat360-documents
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_URL=

# ============================================================================
# HYPERLEDGER FABRIC BLOCKCHAIN
# ============================================================================
BLOCKCHAIN_ENABLED=true
FABRIC_NETWORK_NAME=adalat360-network
FABRIC_CHANNEL=adalat360-channel
FABRIC_CHAINCODE=custody-ledger
FABRIC_CHAINCODE_VERSION=1.0.0

# Officer Node
FABRIC_OFFICER_PEERS=localhost:7051
FABRIC_OFFICER_CA=http://localhost:7054
FABRIC_OFFICER_ADMIN_CERT=
FABRIC_OFFICER_ADMIN_KEY=

# Forensic Lab Node
FABRIC_FORENSIC_PEERS=localhost:8051
FABRIC_FORENSIC_CA=http://localhost:8054
FABRIC_FORENSIC_ADMIN_CERT=
FABRIC_FORENSIC_ADMIN_KEY=

# Court Node
FABRIC_COURT_PEERS=localhost:9051
FABRIC_COURT_CA=http://localhost:9054
FABRIC_COURT_ADMIN_CERT=
FABRIC_COURT_ADMIN_KEY=

# Central Audit Node
FABRIC_AUDIT_PEERS=localhost:10051
FABRIC_AUDIT_CA=http://localhost:10054
FABRIC_AUDIT_ADMIN_CERT=
FABRIC_AUDIT_ADMIN_KEY=

# Orderers
FABRIC_ORDERERS=localhost:7050

FABRIC_TLS_CERT_PATH=./fabric-config/tls
FABRIC_WALLET_PATH=./fabric-wallet

# ============================================================================
# DOCUMENT INGESTION / OCR
# ============================================================================
MAX_FILE_SIZE=104857600
OCR_ENABLED=true
OCR_LANGUAGES=eng,hin
TESSERACT_PATH=tesseract
OCR_DPI=300
ENTITY_EXTRACTION_ENABLED=true
NLP_MODEL=en_core_web_sm

# ============================================================================
# SEARCH
# ============================================================================
SEARCH_PROVIDER=meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000

# ============================================================================
# WAF
# ============================================================================
WAF_ENABLED=true
WAF_MAX_BODY_SIZE=10485760

# ============================================================================
# AUDIT & LOGGING
# ============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_CONSOLE_LOGS=true
ENABLE_FILE_LOGS=true
LOG_DIR=./logs
LOG_RETENTION_DAYS=2555
BLOCKCHAIN_AUDIT=true

# ============================================================================
# BSA CERTIFICATES
# ============================================================================
BSA_VALIDITY_DAYS=3650
BSA_QR_SIZE=300

# ============================================================================
# RTI
# ============================================================================
RTI_DEADLINE_DAYS=30
RTI_FIRST_APPEAL_DAYS=30
RTI_FEE_AMOUNT=10

# ============================================================================
# ANOMALY DETECTION
# ============================================================================
ANOMALY_DETECTION_ENABLED=true
ANOMALY_BULK_THRESHOLD=50
ANOMALY_BULK_WINDOW=60
ANOMALY_OFF_HOURS_START=22
ANOMALY_OFF_HOURS_END=6
ANOMALY_FAILED_AUTH=5
ANOMALY_FAILED_AUTH_WINDOW=15
ANOMALY_CONCURRENT_SESSIONS=3

# ============================================================================
# EMAIL
# ============================================================================
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@adalat360.gov.in

# ============================================================================
# FEATURE FLAGS
# ============================================================================
FEATURE_BLOCKCHAIN=true
FEATURE_OCR=true
FEATURE_ENTITY_EXTRACTION=true
FEATURE_SEMANTIC_SEARCH=true
FEATURE_BSA=true
FEATURE_RTI=true
FEATURE_ANOMALY=true
FEATURE_QR=true
FEATURE_DS=true